VITE_QWEN_WORKER_URL=https://qwen-coder-worker.alexdevriesxing.workers.dev/
VITE_FLUX_WORKER_URL=https://flux-image-worker.alexdevriesxing.workers.dev/
VITE_MINIMAX_MUSIC_WORKER_URL=https://minimax-music-worker.alexdevriesxing.workers.dev/
VITE_AI_PROVIDER_MODE=live
VITE_ENABLE_DEV_TOOLS=true

# Optional local values used by npm run workers:configure.
# These are applied as Cloudflare Worker secrets and must not be committed.
# OPENROUTER_API_KEY=your-openrouter-key
# MINIMAX_API_KEY=your-minimax-key

# Or set secrets manually:
# (cd workers/qwen-coder-worker && wrangler secret put OPENROUTER_API_KEY)
# (cd workers/minimax-music-worker && wrangler secret put MINIMAX_API_KEY)

# Optional vars:
# OPENROUTER_FREE_MODELS=qwen/qwen3-coder:free,minimax/minimax-m2.5:free
# SAKURA_ALLOWED_ORIGINS=tauri://localhost,http://localhost:1420
# SAKURA_MAX_REQUEST_BYTES=256000
# SAKURA_MAX_OUTPUT_TOKENS=8192
# wrangler secret put SAKURA_WORKER_AUTH_TOKEN

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default Sakura Coder desktop permissions. Tighten before production.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "shell:allow-open",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "https://qwen-coder-worker.alexdevriesxing.workers.dev/**" },
        { "url": "https://flux-image-worker.alexdevriesxing.workers.dev/**" },
        { "url": "https://minimax-music-worker.alexdevriesxing.workers.dev/**" }
      ]
    },
    "core:event:default",
    "core:path:default"
  ]
}

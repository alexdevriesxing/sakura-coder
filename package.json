{
  "name": "sakura-coder",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Sakura Coder: local-first desktop AI IDE for planning, coding, Markdown generation and Flux asset creation.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "browser": "playwright open http://localhost:5173",
    "workers:configure": "node scripts/configure-workers.mjs",
    "workers:probe": "node scripts/probe-workers.mjs",
    "workers:probe:full": "node scripts/probe-workers.mjs --full",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-http": "2.5.9",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-shell": "2.3.5",
    "clsx": "2.1.1",
    "lucide-react": "1.14.0",
    "monaco-editor": "0.53.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.59.1",
    "@tauri-apps/cli": "2.11.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "10.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "fast-check": "4.7.0",
    "jsdom": "29.1.1",
    "playwright": "1.59.1",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.1",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
